{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "krossi",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./cloudflare-dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/"]
  }
}
